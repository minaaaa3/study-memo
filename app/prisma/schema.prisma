// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js required models
model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  password      String?      // For credentials provider
  image         String?
  accounts      Account[]
  sessions      Session[]
  progress      Progress[]
  quizResults   QuizResult[]
  annotations   Annotation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Text annotation model (user's private comments on selected text)
model Annotation {
  id           String   @id @default(cuid())
  userId       String
  slug         String   // document slug
  selectedText String   // the selected text
  prefix       String   // text before selection (for anchoring)
  suffix       String   // text after selection (for anchoring)
  comment      String   @db.Text
  color        String   @default("yellow")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, slug])
}

// Progress tracking model
model Progress {
  id          String   @id @default(cuid())
  userId      String
  slug        String   // e.g., "01-web-basics/01-what-is-web"
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

// Quiz results model
model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  slug      String   // e.g., "01-web-basics/01-what-is-web"
  score     Int      // Number of correct answers
  total     Int      // Total number of questions
  answers   Json     // Array of user's answers: { questionId: string, selectedIndex: number, correct: boolean }[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, slug])
}
